import streamlit as st


class AlertEngine:

    def __init__(self):
        pass

    # ============================
    # Buy Alert
    # ============================

    def buy_alert(self, symbol, price):

        st.success(f"🟢 BUY : {symbol} @ ₹{price}")

    # ============================
    # Sell Alert
    # ============================

    def sell_alert(self, symbol, price):

        st.error(f"🔴 SELL : {symbol} @ ₹{price}")

    # ============================
    # Watch Alert
    # ============================

    def watch_alert(self, symbol):

        st.warning(f"🟡 WATCH : {symbol}")

    # ============================
    # Streamlit Notification
    # ============================

    def notify(self, signal, symbol, price):

        signal = str(signal).upper()

        if signal == "BUY":
            self.buy_alert(symbol, price)

        elif signal == "SELL":
            self.sell_alert(symbol, price)

        else:
            self.watch_alert(symbol)

