        # Future implementation
        return True

    # ============================
    # Process Alert
    # ============================

    def process(self, signal, symbol, price):

        self.notify(signal, symbol, price)

        message = f"{signal} | {symbol} | ₹{price}"

        self.telegram_alert(message)

        self.whatsapp_alert(message)

        return True
